local Net = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Net")
local RegisterAttack = Net and Net:FindFirstChild("RE/RegisterAttack")
local RegisterHit = Net and Net:FindFirstChild("RE/RegisterHit")

local function enemiesInRange()
    local root = getRoot()
    local list = {}
    if not root then return list end
    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 and (hrp.Position - root.Position).Magnitude <= ATTACK_RANGE then
            table.insert(list, mob)
        end
    end
    return list
end

local function nearestOf(list)
    local root = getRoot()
    local best, bestD = nil, math.huge
    if not root then return end
    for _, mob in ipairs(list) do
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - root.Position).Magnitude
            if d < bestD then best, bestD = mob, d end
        end
    end
    return best
end

-- Hit validation of the current game version (same calls as the working Banana Hub):
--  1) RegisterAttack + the hit, sent through the client's own SendHitsToServer when
--     the game uses the combat thread (or straight through RegisterHit when it does not)
--  2) Melee / Sword: a "seed" request and a second, encoded RegisterHit remote
local Hit = {enc = nil, encId = nil, send = nil, sendAt = -100}
local ARM_PARTS = {"RightLowerArm", "RightUpperArm", "LeftLowerArm", "LeftUpperArm", "RightHand", "LeftHand"}

pcall(function()
    local function take(c)
        if c:IsA("RemoteEvent") and c:GetAttribute("Id") then Hit.enc, Hit.encId = c, c:GetAttribute("Id") end
    end
    for _, name in ipairs({"Util", "Common", "Remotes", "Assets", "FX"}) do
        local f = RS:FindFirstChild(name)
        if f then
            for _, c in ipairs(f:GetChildren()) do take(c) end
            f.ChildAdded:Connect(take)
        end
    end
end)

local function getSend()
    if tick() - Hit.sendAt < 30 then return Hit.send end
    Hit.sendAt = tick()
    Hit.send = nil
    pcall(function()
        local ps = Player:FindFirstChild("PlayerScripts")
        local ls = ps and ps:FindFirstChildOfClass("LocalScript")
        if ls and getsenv then Hit.send = getsenv(ls)._G.SendHitsToServer end
    end)
    return Hit.send
end

local function combatThread()
    local ok, v = pcall(function() return require(RS.Modules.Flags).COMBAT_REMOTE_THREAD end)
    return ok and (v or false)
end

local function encodedHit(list)
    local seedRF = Net and Net:FindFirstChild("seed")
    local head = list[1] and list[1]:FindFirstChild("Head")
    if not seedRF or not head then return end
    local t59 = {}
    for _, mob in ipairs(list) do
        for _, part in ipairs(mob:GetChildren()) do
            if part:IsA("BasePart") then table.insert(t59, {mob, part}) end
        end
    end
    if #t59 == 0 then return end
    local response = seedRF:InvokeServer()
    RegisterAttack:FireServer()
    RegisterHit:FireServer(head, t59, {})
    if Hit.enc and type(response) == "number" then
        local k = math.floor(workspace:GetServerTimeNow() / 10 % 10) + 1
        local name = (string.gsub("RE/RegisterHit", ".", function(c) return string.char(bit32.bxor(string.byte(c), k)) end))
        local v = bit32.bxor(Hit.encId + 909090, response * 2)
        ;(cloneref or function(x) return x end)(Hit.enc):FireServer(name, v, head, t59)
    end
end

local function registerHits(list)
    if not (RegisterAttack and RegisterHit) or #list == 0 then return end
    local t52, first = {}, nil
    for _, mob in ipairs(list) do
        if not mob:GetAttribute("IsBoat") then
            local part = mob:FindFirstChild(ARM_PARTS[math.random(#ARM_PARTS)]) or mob.PrimaryPart or mob:FindFirstChild("HumanoidRootPart")
            if part then
                table.insert(t52, {mob, part})
                first = part
            end
        end
    end
    if not first then return end
    pcall(function() RegisterAttack:FireServer(0) end)
    local thread, send = combatThread(), getSend()
    if thread and send then
        pcall(send, first, t52)
    elseif not thread then
        pcall(function() RegisterHit:FireServer(first, t52) end)
    end
    local tool = Player.Character and Player.Character:FindFirstChildOfClass("Tool")
    local wt = tool and tool:GetAttribute("WeaponType")
    if wt == "Melee" or wt == "Sword" then
        task.spawn(function() pcall(encodedHit, list) end)
    end
end

local function attack()
    equipWeapon()
    local root = getRoot()
    local list = enemiesInRange()
    if State.Weapon == "Blox Fruit" then
        -- fruit M1 from a distance: the fruit's own click remote aimed at the
        -- closest mob, plus the hit registration for every mob in range
        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        local target = nearestOf(list)
        local remote = tool and tool.ToolTip == "Blox Fruit" and tool:FindFirstChild("LeftClickRemote")
        if remote and target and root then
            local dir = target.HumanoidRootPart.Position - root.Position
            -- hovering above the mob: aim straight down (what the working source sends)
            local aim = (dir.Y < -8 or dir.Magnitude == 0) and Vector3.new(0.01, -500, 0.01) or dir.Unit
            pcall(function()
                remote:FireServer(aim, 1, true)
                remote:FireServer(false)
            end)
            -- no damage for 2.5 s on the same target: also use the game's own M1 (what a real click does)
            local th = target:FindFirstChildOfClass("Humanoid")
            if th then
                if State.FruitTarget ~= target or th.Health < (State.FruitHP or 0) then
                    State.FruitTarget, State.FruitHP, State.FruitSince = target, th.Health, tick()
                elseif tick() - (State.FruitSince or tick()) > 2.5 then
                    State.FruitAlt = true
                end
            end
            if State.FruitAlt then
                pcall(function() tool:Activate() end)
                VirtualUser:CaptureController()
                VirtualUser:Button1Down(Vector2.new(1280, 672))
                VirtualUser:Button1Up(Vector2.new(1280, 672))
            end
            registerHits(list)
        elseif not remote then
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector2.new(1280, 672))
            VirtualUser:Button1Up(Vector2.new(1280, 672))
            registerHits(list)
        end
    elseif State.FastAttack and RegisterAttack and RegisterHit and #list > 0 then
        registerHits(list)
    else
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(1280, 672))
        task.wait(0.03)
        VirtualUser:Button1Up(Vector2.new(1280, 672))
    end
end

-- Height kept above the mob. A normal click (Fast Attack off) only reaches
-- close targets, so in that case we stay low; fast attack / fruit hit from far.
local function hoverHeight()
    if State.Weapon == "Blox Fruit" or State.FastAttack then return ATTACK_HEIGHT end
    return math.min(ATTACK_HEIGHT, 7)
end

local function findEnemy(names, area)
    local root = getRoot()
    if not root then return end
    local best, bestDist = nil, math.huge
    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        local hum = mob:FindFirstChildOfClass("Humanoid")
        -- with a farm area, mobs of the same name on other parts of the map are ignored
        if hrp and hum and hum.Health > 0 and (not area or (hrp.Position - area.center).Magnitude <= area.radius) then
            for _, n in ipairs(names) do
                if mob.Name:find(n, 1, true) then
                    local d = (hrp.Position - root.Position).Magnitude
                    if d < bestDist then best, bestDist = mob, d end
                end
            end
        end
    end
    return best
end

local function findSpawn(names)
    local root = getRoot()
    local folder = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("EnemySpawns")
    if not root or not folder then return end
    local best, bestDist = nil, math.huge
    for _, s in ipairs(folder:GetChildren()) do
        for _, n in ipairs(names) do
            if s.Name:find(n, 1, true) then
                local part = s:IsA("BasePart") and s or s:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local d = (part.Position - root.Position).Magnitude
                    if d < bestDist then best, bestDist = part, d end
                end
            end
        end
    end
    return best
end

-- Farm area: the group of spawn points of these mobs that is closest to us.
-- The script only hunts inside it, so after killing the nearby mobs it waits
-- for the respawn there instead of flying to another part of the map.
local farmArea = {key = nil}
local function getFarmArea(names)
    if not names then return nil end
    local key = table.concat(names, "|")
    if farmArea.key == key and farmArea.center then return farmArea end
    local root = getRoot()
    local folder = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("EnemySpawns")
    if not root or not folder then return nil end
    local parts, s0, d0 = {}, nil, math.huge
    for _, sp in ipairs(folder:GetChildren()) do
        for _, n in ipairs(names) do
            if sp.Name:find(n, 1, true) then
                local part = sp:IsA("BasePart") and sp or sp:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    table.insert(parts, part)
                    local d = (part.Position - root.Position).Magnitude
                    if d < d0 then s0, d0 = part, d end
                end
                break
            end
        end
    end
    if not s0 then return nil end
    local cluster, sum = {}, Vector3.zero
    for _, part in ipairs(parts) do
        if (part.Position - s0.Position).Magnitude <= 900 then
            table.insert(cluster, part)
            sum = sum + part.Position
        end
    end
    local center = sum / #cluster
    local radius = 0
    for _, part in ipairs(cluster) do
        radius = math.max(radius, (part.Position - center).Magnitude)
    end
    farmArea = {key = key, center = center, radius = radius + 250, spawns = cluster}
    return farmArea
end

-- Reads the quest window: visible?, kills, total (looks at every label,
-- so it works in any game language). When the real total of the quest is
-- known (8 for the bone quests) only a counter with that total is trusted,
-- so no other "x/y" text in the window can fake a finished quest.
local function readQuest()
    local gui = Player.PlayerGui:FindFirstChild("Main")
    local q = gui and gui:FindFirstChild("Quest")
    if not q or not q.Visible then return false end
    local cur, max
    for _, d in ipairs(q:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text then
            local c, m = d.Text:match("(%d+)%s*/%s*(%d+)")
            c, m = tonumber(c), tonumber(m)
            if c and m and c <= m and (not State.QuestTotal or m == State.QuestTotal) then
                cur, max = c, m
                break
            end
        end
    end
    return true, cur, max
end

-- Total kills the quest asks for (read from the game's own quest list)
local totalCache = {}
local function questTotal(data)
    if not data or not data.Quest then return nil end
    local key = data.Quest.Name .. "#" .. data.Quest.Level
    if totalCache[key] ~= nil then return totalCache[key] or nil end
    local ok, quests = pcall(function() return require(RS:WaitForChild("Quests", 5)) end)
    local total
    if ok and type(quests) == "table" then
        local lv = quests[data.Quest.Name] and quests[data.Quest.Name][data.Quest.Level]
        if lv and type(lv.Task) == "table" then
            for _, c in pairs(lv.Task) do total = c break end
        end
    end
    totalCache[key] = total or false
    return total
end

-- Our own kill counter for the quest mob (safety net in case the window
-- cannot be read): counts every death of the quest mob after the quest was taken
local lastKillAt = 0
local watched = setmetatable({}, {__mode = "k"})
task.spawn(function()
    while task.wait(0.5) do
        if State.Farming and State.GetQuest and State.QuestMob then
            for _, mob in ipairs(workspace.Enemies:GetChildren()) do
                if mob.Name:find(State.QuestMob, 1, true) then
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    if hum and not watched[hum] then
                        watched[hum] = true
                        hum.Died:Connect(function()
                            State.Kills += 1
                            lastKillAt = tick()
                        end)
                    end
                end
            end
        end
    end
end)

-- Spawn points already checked recently (so we walk the island instead of
-- waiting next to the spot where the last mob died)
local visitedSpawns = {}
local function findHuntSpawn(names, area)
    local root = getRoot()
    if not root then return end
    local best, bestDist = nil, math.huge
    local candidates = area and area.spawns
    if not candidates then
        candidates = {}
        local folder = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("EnemySpawns")
        if not folder then return end
        for _, sp in ipairs(folder:GetChildren()) do
            for _, n in ipairs(names) do
                if sp.Name:find(n, 1, true) then
                    local part = sp:IsA("BasePart") and sp or sp:FindFirstChildWhichIsA("BasePart", true)
                    if part then table.insert(candidates, part) end
                    break
                end
            end
        end
    end
    for _, part in ipairs(candidates) do
        local d = (part.Position - root.Position).Magnitude
        if d <= 70 then visitedSpawns[part] = tick() end
        if tick() - (visitedSpawns[part] or 0) > 25 and d < bestDist then
            best, bestDist = part, d
        end
    end
    if not best then
        visitedSpawns = {}
        -- everything visited: start another round of the same area
        for _, part in ipairs(candidates) do
            local d = (part.Position - root.Position).Magnitude
            if d < bestDist then best, bestDist = part, d end
        end
    end
    return best
end

local function questUIActive()
    local vis, cur, max = readQuest()
    if not vis then return false end
    if cur and max and cur >= max then return false end
    return true
end

-- A new quest is only taken when the current one is FINISHED:
--  * the counter reached the total (e.g. 8/8), or
--  * our own kill counter reached the total, or
--  * the window closed right after the last kill (the game removes it
--    when the quest completes), or
--  * the window has been gone for 60s with no kills (quest was lost).
-- A window that just flickers away in the middle of the quest changes nothing.
local questTakenAt = 0
local lastQuestSeen = 0
local lastCur, lastMax = nil, nil
local function killsDone()
    return State.QuestTotal and State.Kills >= State.QuestTotal
end
local function hasQuest()
    if tick() - questTakenAt < 8 then return true end
    local vis, cur, max = readQuest()
    if vis then
        lastQuestSeen = tick()
        if cur and max then
            lastCur, lastMax = cur, max
            return cur < max
        end
        return not killsDone() -- window visible but counter unreadable
    end
    -- window not visible
    if killsDone() then return false end
    if lastMax and lastCur and lastCur >= lastMax - 1 and tick() - lastQuestSeen < 15 then
        return false -- last kill closed the window
    end
    local quiet = math.min(tick() - lastQuestSeen, tick() - lastKillAt)
    return quiet < 60
end

local nextQuestTry = 0
local questGoneSince = nil
local questNPC = {}      -- [quest name] = position where the quest was accepted (the quest giver)
local questFails = 0

-- Session memory: where each quest mob was last farmed (centre of its island).
-- Used to go to that island first when its quest giver is not streamed in yet.
local spotOf = {}

-- Clears the quest bookkeeping (Start Farm, Get Quest or the method switched on), so
-- the quest of the CURRENT level is taken right away and no old quest is kept.
local function resetQuestFlow()
    nextQuestTry = 0
    questFails = 0
    questGoneSince = nil
    questTakenAt = 0
    levelCache.lk, levelCache.data = nil, nil
    State.FightPos, State.FightAt = nil, 0
end

-- Position of the quest giver with this name (the closest one if there are several)
local function npcPosition(name)
    if not name then return nil end
    local npcs = workspace:FindFirstChild("NPCs")
    local root = getRoot()
    if not npcs or not root then return nil end
    local best, bestDist = nil, math.huge
    for _, npc in ipairs(npcs:GetChildren()) do
        if npc.Name == name then
            local ok, p = pcall(function() return npc:GetPivot().Position end)
            if ok then
                local d = (p - root.Position).Magnitude
                if d < bestDist then best, bestDist = p, d end
            end
        end
    end
    return best
end

-- Takes the quest. The quest giver is not known in advance: first the saved
-- position is used; if there is none, the NPCs near the mobs are visited one
-- by one (closest first) and StartQuest is tried at each of them. The first
-- one that really opens the quest window is saved, so the next quests of the
-- same giver go straight there. If nothing works the farm goes on without
-- the quest and the next try waits longer (no more flying around in loops).
local function takeQuest(data, reason)
    if not data.Quest then return end
    if tick() < nextQuestTry then return end
    if questUIActive() then questTakenAt = tick() return end -- still has a quest
    local q = data.Quest
    nextQuestTry = tick() + 6

    local function start()
        pcall(function()
            RS.Remotes.CommF_:InvokeServer("StartQuest", q.Name, q.Level)
        end)
        task.wait(0.6)
        return questUIActive()
    end
    local function accepted(pos)
        if pos then questNPC[q.Name] = pos end
        questFails = 0
        nextQuestTry = 0
        questTakenAt = tick()
        lastQuestSeen = tick()
        lastCur, lastMax = 0, nil
        State.Kills = 0
        return true
    end
    local function alive()
        local r, h = getRoot()
        return State.Farming and r and h and h.Health > 0
    end

    Fluent:Notify({Title = "Dark Hub", Content = "Taking quest (" .. tostring(reason or "?") .. "): " .. q.Name .. " #" .. q.Level, Duration = 5})

    -- 1) the giver we already know
    local known = (typeof(q.NPC) == "CFrame" and q.NPC.Position) or questNPC[q.Name] or npcPosition(q.NPCName)
    if not known and data.QuestMob and spotOf[data.QuestMob] then
        -- the giver is not streamed in: go to the island of this mob first, then look again
        flyAndWait(CFrame.new(spotOf[data.QuestMob] + Vector3.new(0, 30, 0)))
        if not alive() then return end
        known = npcPosition(q.NPCName)
    end
    if known then
        flyAndWait(CFrame.new(known + Vector3.new(0, 4, 0)))
        if not alive() then return end
        if start() then return accepted() end
        -- The giver is known but StartQuest failed: most likely the quest is still
        -- active on the server (the window was just not readable). Do NOT tour the
        -- other NPCs; keep farming and try again later. Only after repeated failures
        -- the saved position is dropped and the search starts again.
        questFails += 1
        if questFails < 3 or q.NPC then
            nextQuestTry = tick() + math.min(30 * questFails, 180)
            questTakenAt = tick()
            lastQuestSeen = tick()
            return
        end
        questNPC[q.Name] = nil
    end

    -- 2) maybe we are already close enough
    if not alive() then return end
    if start() then
        local r = getRoot()
        return accepted(r and r.Position)
    end

    -- 3) visit the NPCs around the mobs, closest first
    local area = getFarmArea(data.Mobs)
    local root = getRoot()
    local anchor = area and area.center
    if not anchor then
        local sp = findSpawn(data.Mobs)
        anchor = sp and sp.Position or (root and root.Position)
    end
    local list = {}
    local npcs = workspace:FindFirstChild("NPCs")
    if anchor and npcs then
        for _, n in ipairs(npcs:GetChildren()) do
            local okp, p = pcall(function() return n:GetPivot().Position end)
            if okp then
                local d = (p - anchor).Magnitude
                if d <= 500 then table.insert(list, {pos = p, d = d}) end
            end
        end
        table.sort(list, function(x, y) return x.d < y.d end)
    end
    local tried = {}
    for _, c in ipairs(list) do
        if #tried >= 4 then break end
        local dup = false
        for _, tp in ipairs(tried) do
            if (tp - c.pos).Magnitude < 25 then dup = true break end
        end
        if not dup then
            table.insert(tried, c.pos)
            flyAndWait(CFrame.new(c.pos + Vector3.new(0, 4, 0)))
            if not alive() then return end
            if start() then return accepted(c.pos) end
        end
    end

    -- 4) nothing worked: farm without the quest and try again later
    questFails += 1
    nextQuestTry = tick() + math.min(30 * questFails, 180)
    if questFails == 2 then
        Fluent:Notify({Title = "Dark Hub", Content = "Could not take the quest of " .. q.Name .. ". Take it by hand once: the script keeps farming the mob and the next quests are taken by themselves.", Duration = 10})
    end
    questTakenAt = tick() -- keeps farming here instead of retrying right away
    lastQuestSeen = tick()
end

local function refreshFarming()
    State.Farming = State.StartFarm or State.RipIndra or State.FullyDK or State.Captain or State.Ghoul or State.Cyborg or State.Halloween or (State.HopCount or 0) > 0 -- Get Quest only adds quests to the selected farm
    if not State.Farming then
        setHover(false)
        if currentTween then currentTween:Cancel() end
        VirtualUser:Button1Up(Vector2.new(1280, 672))
    end
end

local function bringMobs(target, names)
    if not State.BringMob then return end
    local thrp = target:FindFirstChild("HumanoidRootPart")
    if not thrp then return end
    local count = 1
    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
        if count >= State.BringCount then break end
        if mob ~= target then
            local match = mob.Name == target.Name
            if not match and names then
                for _, n in ipairs(names) do
                    if mob.Name:find(n, 1, true) then match = true break end
                end
            end
            if match then
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 and (hrp.Position - thrp.Position).Magnitude <= 500 then
                    hrp.CFrame = thrp.CFrame
                    hrp.CanCollide = false
                    hum.WalkSpeed = 0
                    count += 1
                end
            end
        end
    end
end


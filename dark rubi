-- Items: the Fist / Core Brain / Microchip are tools of the backpack (or of the inventory list)
local function hasItem(name)
    for _, c in ipairs({Player.Backpack, Player.Character}) do
        if c and c:FindFirstChild(name) then return true end
    end
    return inventoryCount(name) > 0
end

local function hasChip()
    for _, c in ipairs({Player.Backpack, Player.Character}) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("microchip", 1, true) then return true end
            end
        end
    end
    return false
end

local function fragments()
    local d = Player:FindFirstChild("Data")
    local f = d and d:FindFirstChild("Fragments")
    return f and f.Value
end

-- Flies towards a position, true when we are there
function Cyb.goTo(pos, near)
    local root = getRoot()
    if not root then return false end
    if (root.Position - pos).Magnitude <= near then return true end
    setHover(true)
    flyTo(CFrame.new(pos))
    return false
end

-- Joins a random public server that has room (used to look for more chests)
function Hop.anyServer()
    local ok, res = pcall(function()
        return Hop.Http:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    local pool = {}
    if ok and type(res) == "table" and res.data then
        for _, sv in ipairs(res.data) do
            if sv.id ~= game.JobId and sv.playing < sv.maxPlayers then table.insert(pool, sv.id) end
        end
    end
    if #pool == 0 then return false end
    local job = game.JobId
    Hop.save(true)
    pcall(function() Hop.TS:TeleportToPlaceInstance(game.PlaceId, pool[math.random(#pool)], Player) end)
    for _ = 1, 16 do
        task.wait(0.5)
        if game.JobId ~= job then return true end
    end
    Hop.save(false)
    return false
end

-- Arlthmetic (sells the Order raid Microchip) lives next to the Secret Laboratory
local function labNPC()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return end
    for _, n in ipairs(npcs:GetChildren()) do
        local name = n.Name:lower()
        if name:find("ar[li]thmetic") or name:find("junior j", 1, true) then return n end
    end
end

-- Center of the lab: the saved raid spot, else Arlthmetic, else the hot side of the island
-- (second value: true when the position is exact)
function Cyb.center()
    if Cyb.spot then return Cyb.spot, true end
    local npc = labNPC()
    if npc then
        local ok, p = pcall(function() return npc:GetPivot().Position end)
        if ok then return p, true end
    end
    local sp = findSpawn({"Lava Pirate", "Magma Ninja"})
    return sp and sp.Position or Vector3.new(-5400, 60, -5200), false
end

-- Buttons (ClickDetector / ProximityPrompt) around the lab, the ones with a raid-like name first
function Cyb.buttons(center)
    if Cyb.btnCache and Cyb.btnFor and (Cyb.btnFor - center).Magnitude < 10 then return Cyb.btnCache end
    local named, plain, count = {}, {}, 0
    local npcs = workspace:FindFirstChild("NPCs")
    for _, d in ipairs(workspace:GetDescendants()) do
        count += 1
        if count % 3000 == 0 then task.wait() end -- do not freeze the game
        if (d:IsA("ClickDetector") or d:IsA("ProximityPrompt")) and not (npcs and d:IsDescendantOf(npcs)) then
            local part = d.Parent
            if not (part and part:IsA("BasePart")) then part = d:FindFirstAncestorWhichIsA("BasePart") end
            if part then
                local dist = (part.Position - center).Magnitude
                if dist <= 300 then
                    local hits, node = 0, d
                    for _ = 1, 4 do
                        node = node.Parent
                        if not node or node == workspace then break end
                        local nm = node.Name:lower()
                        for _, w in ipairs(Cyb.LAB_WORDS) do
                            if nm:find(w, 1, true) then hits += 1 break end
                        end
                    end
                    table.insert(hits > 0 and named or plain, {obj = d, pos = part.Position, hits = hits, dist = dist})
                end
            end
        end
    end
    local list = #named > 0 and named or plain
    table.sort(list, function(a, b)
        if a.hits ~= b.hits then return a.hits > b.hits end
        return a.dist < b.dist
    end)
    Cyb.btnCache, Cyb.btnFor = list, center
    return list
end

-- Stands where the host stands (saved raid spot, else on a button), puts everything down
-- and presses the lab button(s). Returns "fired" after a press, otherwise "moving" / "wait".
function Cyb.press(center)
    local list = Cyb.buttons(center)
    if #list == 0 and not Cyb.spot then
        hopNote("No lab button found. Stand inside the dark blue chamber of the Secret Laboratory and press Save Raid Spot (Stack Farm).")
        return "wait"
    end
    local target = Cyb.spot
    if not target then
        local b = list[(Cyb.variant % #list) + 1]
        target = b.pos + Vector3.new(0, 3, 0)
    end
    if not Cyb.goTo(target, 5) then return "moving" end
    local root, hum = getRoot()
    local char = Player.Character
    if hum and char and char:FindFirstChildOfClass("Tool") then
        hum:UnequipTools() -- the game does not accept the button while you hold something
        return "wait"
    end
    if tick() - Cyb.last.press < 3 then return "wait" end
    Cyb.last.press = tick()
    Cyb.fired += 1
    if Cyb.fired % 3 == 0 then Cyb.variant += 1 end -- not working: try the next button
    local n, first = 0, nil
    for _, b in ipairs(list) do
        if n >= 4 then break end
        if b.obj.Parent and (b.pos - root.Position).Magnitude <= 60 then
            n += 1
            first = first or b.obj:GetFullName()
            pcall(function()
                if b.obj:IsA("ClickDetector") then fireclickdetector(b.obj) else fireproximityprompt(b.obj) end
            end)
        end
    end
    hopNote("Lab: pressed " .. n .. " button(s)" .. (first and (" (" .. first:sub(-55) .. ")") or ""))
    return "fired"
end

-- Learns the remote call that buys the Microchip: the CommF_ calls are remembered and,
-- when a Microchip shows up in the backpack, the call made just before it is saved
function Cyb.hook()
    if Cyb.hooked or not (hookmetamethod and getnamecallmethod) then return end
    local commF = RS.Remotes.CommF_
    local old
    Cyb.hooked = pcall(function()
        old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
            local method = getnamecallmethod()
            if self == commF and method == "InvokeServer" then
                table.insert(Cyb.recent, {t = tick(), args = {...}})
                if #Cyb.recent > 8 then table.remove(Cyb.recent, 1) end
            end
            return old(self, ...)
        end))
    end)
end

local function simpleArgs(args)
    for _, a in ipairs(args) do
        local t = type(a)
        if t ~= "string" and t ~= "number" and t ~= "boolean" then return false end
    end
    return #args > 0
end

local function watchBackpack()
    local bp = Player:WaitForChild("Backpack", 10)
    if not bp then return end
    bp.ChildAdded:Connect(function(t)
        if Cyb.recipe or not Cyb.hooked or not t:IsA("Tool") or not t.Name:lower():find("microchip", 1, true) then return end
        for i = #Cyb.recent, 1, -1 do
            local r = Cyb.recent[i]
            if tick() - r.t < 8 and not Cyb.IGNORED[r.args[1]] and simpleArgs(r.args) then
                Cyb.recipe = r.args
                Cyb.save()
                Fluent:Notify({Title = "Dark Hub", Content = "Learned how to buy the Microchip (" .. tostring(r.args[1]) .. "). It will be repeated by itself.", Duration = 8})
                return
            end
        end
    end)
end

-- Farm loop
---------------------------------------------------------------------
task.spawn(function()
    while task.wait(0.15) do
        if not State.Farming then
            if bv then setHover(false) end
            if currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then currentTween:Cancel() end
            setStatus("Idle")
            continue
        end
        local ok, err = pcall(function()
            local root, hum = getRoot()
            if not root or not hum or hum.Health <= 0 then
                setStatus("Dead | waiting to respawn")
                return
            end

            -- Stack Farm options run first
            if State.RipIndra and ripIndra() then return end
            if State.Captain and cursedCaptain() then return end
            if State.Ghoul and ghoulRace() then return end
            if State.Cyborg and cyborgRace() then return end
            if State.Halloween and halloween() then return end
            if State.HopCount > 0 and Hop.step() then return end
            if State.FullyDK and fullyDK() then return end
            if not State.StartFarm then return end

            -- Level farm: make sure we are in the sea that fits our level
            if State.Method == "Level" and CURRENT_SEA then
                local lvl = getLevel()
                local want = lvl >= 1500 and 3 or (lvl >= 700 and 2 or 1)
                if want ~= CURRENT_SEA and seaTravelTries >= 3 and not State.WrongSeaWarned then
                    State.WrongSeaWarned = true
                    Fluent:Notify({Title = "Dark Hub", Content = "Level " .. lvl .. " should farm in Sea " .. want .. " but you are in Sea " .. CURRENT_SEA .. ". Travel there by hand; farming the best Sea " .. CURRENT_SEA .. " quest meanwhile.", Duration = 10})
                end
                if want ~= CURRENT_SEA and seaTravelTries < 3 then
                    setStatus("Lv " .. lvl .. " | travelling to Sea " .. want)
                    if tick() - lastSeaTravel > 20 then
                        lastSeaTravel = tick()
                        seaTravelTries += 1
                        Fluent:Notify({Title = "Dark Hub", Content = "Your level fits Sea " .. want .. ". Travelling there - run the script again after the teleport.", Duration = 10})
                        pcall(function() RS.Remotes.CommF_:InvokeServer(SEA_TRAVEL[want]) end)
                    end
                    return
                end
            end

            local data = State.Method == "Level" and getLevelQuest() or Methods[State.Method]
            if not data then
                setStatus("Lv " .. getLevel() .. " | no quest found in this sea")
                return
            end
            -- some methods only exist in one sea
            if data.Sea and CURRENT_SEA and data.Sea ~= CURRENT_SEA then
                setStatus(State.Method .. " only works in Sea " .. data.Sea .. " (you are in Sea " .. CURRENT_SEA .. ")")
                return
            end

            if State.Method == "Level" then
                local am = activeQuestMob()
                if am and am ~= data.Mobs[1] then
                    data = {Mobs = {am}, QuestMob = am, Label = "active quest", Quest = data.Quest,
                        Submerged = SUBMERGED_MOBS[am] == true}
                end
            end

            -- quest info used by the quest checks (no total check for an already running Level quest)
            State.QuestMob = data.QuestMob
            State.QuestTotal = (data.Label ~= "active quest") and questTotal(data) or nil

            local lvlText = "Lv " .. getLevel() .. " | " .. (data.Label or State.Method) .. " | " .. (data.Mobs[1] or "?")
            if State.GetQuest then
                local qv, qc, qm = readQuest()
                lvlText = lvlText .. " | quest " .. (qc and (qc .. "/" .. qm) or (qv and "?" or "none")) .. " (kills " .. State.Kills .. ")"
            end
            if data.Submerged then
                local sp = findSpawn(data.Mobs)
                local inSub = findEnemy(data.Mobs) ~= nil
                    or (sp and (sp.Position - root.Position).Magnitude < 1500)
                    or tick() < (State.SubUntil or 0)
                if not inSub then
                    setStatus(lvlText .. " | going to Submerged Island")
                    goSubmerged()
                    return
                end
            end

            -- 1) quest
            if State.GetQuest and data.Quest then
                if hasQuest() then
                    questGoneSince = nil
                else
                    questGoneSince = questGoneSince or tick()
                    if tick() - questGoneSince > 1 then
                        setStatus(lvlText .. " | taking quest")
                        local qv = readQuest()
                        takeQuest(data, qv and "quest finished" or "no quest window")
                        questGoneSince = nil
                    end
                end
            end

            -- 2) kill the mobs
            local area = getFarmArea(data.Mobs)
            if area and data.QuestMob then spotOf[data.QuestMob] = area.center end
            if farmMobs(data, area) then
                setStatus(lvlText .. " | fighting")
            else
                local mode, sp, dist = idleOrHunt(data.Mobs, area)
                if mode == "wait" then
                    setStatus(lvlText .. " | waiting for the mobs to respawn")
                elseif mode == "hunt" then
                    setStatus(lvlText .. " | flying to the mobs (" .. (math.floor(dist / 100) * 100) .. " studs)")
                else
                    setStatus(lvlText .. " | island not loaded: go there once (the script remembers it)")
                end
            end
        end)
        if not ok then warn("[Dark Hub] " .. tostring(err)) end
    end
end)


-- Halloween tab: Auto Event (Hellfire Halloween 2026, Oct 31 - Nov 15)
-- One switch that does everything, always the biggest thing first:
--   1 Jack-O-Lanterns (pumpkins)  <  2 Trick or Treat doors  <
--   3 pumpkin boss (Great Pumpkin)  <  4 wolf boss / Hell Rider
-- If something bigger exists, the smaller ones are left alone.
-- Plus: the Spooky gacha is rolled whenever there are 500 tokens.
-- The object names of the event are found by keywords.
---------------------------------------------------------------------
local halloween
do
    local HAL = {
        on = false, minTokens = 500,
        prompts = setmetatable({}, {__mode = "k"}), things = setmetatable({}, {__mode = "k"}),
        skip = setmetatable({}, {__mode = "k"}), since = setmetatable({}, {__mode = "k"}),
        FILE = "DarkHub_halloween.json",
        END_TIME = 1794704400, -- 2026-11-15 01:00 UTC
        GUESS = {"SpookyGacha", "HalloweenGacha", "SpookyHalloweenGacha", "ZiolesHalloweenGacha", "ZiolesSpookyGacha", "SpookyZiolesGacha"},
        guess = 1, failed = false, rolls = 0, recipe = nil, conn = nil, scanned = false, rolling = false,
        lastTokens = 0, tokenName = nil,
    }
    local EVENT_PATH = {"halloween", "trick", "treat", "spooky", "harvest", "hellfire", "hellrider", "hell rider", "candy"}
    local TIER_NAMES = {"pumpkin", "door", "pumpkin boss", "wolf boss"}

    -- tier of an enemy by its name (nil = not an event enemy)
    local function enemyTier(name)
        local n = name:lower()
        if n:find("wolf", 1, true) or n:find("hell rider", 1, true) or n:find("hellrider", 1, true) then return 4 end
        if n:find("great pumpkin", 1, true) then return 3 end
        if n:find("pumpkin", 1, true) or n:find("jack", 1, true) or n:find("lantern", 1, true) then return 1 end
    end

    pcall(function()
        if isfile and isfile(HAL.FILE) then
            local d = Hop.Http:JSONDecode(readfile(HAL.FILE))
            if type(d.recipe) == "table" then HAL.recipe = d.recipe end
        end
    end)

    local para
    pcall(function() para = Tabs.Halloween:AddParagraph({Title = "Status", Content = "Off"}) end)
    local lastText
    local function halStatus(text)
        if text == lastText then return end
        lastText = text
        if para then pcall(function() para:SetDesc(text) end) end
        setStatus("Halloween | " .. text)
    end

    -----------------------------------------------------------------
    -- Finding things
    -----------------------------------------------------------------
    local function pathHas(inst, words)
        local ok, p = pcall(inst.GetFullName, inst)
        if not ok then return false end
        p = p:lower()
        for _, w in ipairs(words) do
            if p:find(w, 1, true) then return true end
        end
        return false
    end

    local function ignored(inst)
        for _, name in ipairs({"Enemies", "Characters", "NPCs", "Boats", "SeaBeasts"}) do
            local f = workspace:FindFirstChild(name)
            if f and inst:IsDescendantOf(f) then return true end
        end
        return false
    end

    local function posOf(inst)
        if inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") then inst = inst.Parent end
        if not inst then return nil end
        if inst:IsA("Attachment") then return inst.WorldPosition end
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Model") then
            local ok, p = pcall(function() return inst:GetPivot().Position end)
            return ok and p or nil
        end
        return nil
    end

    local function register(inst)
        if inst:IsA("ProximityPrompt") or inst:IsA("ClickDetector") then
            local l = ""
            if inst:IsA("ProximityPrompt") then l = (inst.ActionText .. " " .. inst.ObjectText):lower() end
            local door = l:find("knock", 1, true) or l:find("trick", 1, true) or l:find("treat", 1, true)
            if not door and pathHas(inst, EVENT_PATH) then
                local p = inst.Parent
                local pn = ((p and p.Name or "") .. " " .. (p and p.Parent and p.Parent.Name or "")):lower()
                door = pn:find("door", 1, true)
            end
            if door and not ignored(inst) then HAL.prompts[inst] = true end
        elseif inst:IsA("BasePart") or inst:IsA("Model") then
            local n = inst.Name:lower()
            if n:find("jack", 1, true) or n:find("lantern", 1, true) or n:find("pumpkin", 1, true) then
                if inst:IsA("BasePart") and inst.Parent and HAL.things[inst.Parent] then return end
                if not ignored(inst) then HAL.things[inst] = true end
            end
        end
    end

    local function startWatching()
        if HAL.conn then return end
        HAL.conn = workspace.DescendantAdded:Connect(function(inst)
            if HAL.on then pcall(register, inst) end
        end)
        if HAL.scanned then return end
        HAL.scanned = true
        task.spawn(function()
            local n = 0
            for _, inst in ipairs(workspace:GetDescendants()) do
                pcall(register, inst)
                n += 1
                if n % 500 == 0 then task.wait() end
            end
        end)
    end

    local function stopWatching()
        if HAL.conn then HAL.conn:Disconnect() HAL.conn = nil end
    end

    local function harvestInfo()
        local t = os.date("!*t", math.floor(workspace:GetServerTimeNow()))
        if t.min < 10 then return true, 10 - t.min end
        return false, 60 - t.min
    end

    -- nearest living event enemy of each tier
    local function eventEnemies()
        local root = getRoot()
        local best, dist = {}, {}
        if not root then return best end
        for _, mob in ipairs(workspace.Enemies:GetChildren()) do
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local tier = hrp and hum and hum.Health > 0 and enemyTier(mob.Name)
            if tier then
                local d = (hrp.Position - root.Position).Magnitude
                if not dist[tier] or d < dist[tier] then best[tier], dist[tier] = mob, d end
            end
        end
        return best
    end

    local function nearestDoor()
        local root = getRoot()
        local best, bestScore
        if not root then return end
        for pr in pairs(HAL.prompts) do
            if not pr.Parent then
                HAL.prompts[pr] = nil
            elseif (HAL.skip[pr] or 0) < tick() and (not pr:IsA("ProximityPrompt") or pr.Enabled) then
                local pos = posOf(pr)
                if pos then
                    local score = (pos - root.Position).Magnitude
                    local c = pr.Parent and (pr.Parent:FindFirstAncestorOfClass("Model") or pr.Parent)
                    -- the door surrounded by flames opens the Hell Rider portal: go there first
                    if c and (c:FindFirstChildWhichIsA("Fire", true) or c.Name:lower():find("hell", 1, true) or c.Name:lower():find("flame", 1, true)) then
                        score -= 1e6
                    end
                    if not best or score < bestScore then best, bestScore = pr, score end
                end
            end
        end
        return best
    end

    local function nearestThing()
        local root = getRoot()
        local best, bestD = nil, math.huge
        if not root then return end
        for obj in pairs(HAL.things) do
            if not obj.Parent then
                HAL.things[obj] = nil
            elseif (HAL.skip[obj] or 0) < tick() then
                local pos = posOf(obj)
                if pos then
                    local d = (pos - root.Position).Magnitude
                    if d < bestD then best, bestD = obj, d end
                end
            end
        end
        return best
    end

    -----------------------------------------------------------------
    -- Actions
    -----------------------------------------------------------------
    local function fight(mob)
        setHover(true)
        flyTo(mob.HumanoidRootPart.CFrame * CFrame.new(0, hoverHeight(), 0))
        State.CombatUntil = tick() + 0.5
    end

    local function knock(pr)
        local root = getRoot()
        local pos = posOf(pr)
        if not root or not pos then return end
        local dist = (root.Position - pos).Magnitude
        if dist > 10 then
            setHover(true)
            flyTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
            return dist
        end
        HAL.skip[pr] = tick() + 25 -- one knock per door; go on to the next one
        if pr:IsA("ProximityPrompt") then
            pcall(function()
                pr.HoldDuration = 0
                pr.RequiresLineOfSight = false
                pr.MaxActivationDistance = math.max(pr.MaxActivationDistance, 20)
            end)
            if fireproximityprompt then
                pcall(fireproximityprompt, pr)
            else
                pcall(function() pr:InputHoldBegin() task.wait(0.15) pr:InputHoldEnd() end)
            end
        elseif fireclickdetector then
            pcall(fireclickdetector, pr)
        end
        return 0
    end

    local function equipMelee()
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local cur = char and char:FindFirstChildOfClass("Tool")
        if not hum or (cur and cur.ToolTip == "Melee") then return end
        for _, t in ipairs(Player.Backpack:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == "Melee" then
                hum:EquipTool(t)
                return
            end
        end
    end

    -- a Jack-O-Lantern is hit with the fighting style: M1 click plus the hit calls
    local function smash(obj)
        local root = getRoot()
        local pos = posOf(obj)
        if not root or not pos then return end
        local dist = (root.Position - pos).Magnitude
        setHover(true)
        flyTo(CFrame.lookAt(pos + Vector3.new(3, 0, 0), pos))
        if dist <= 12 then
            HAL.since[obj] = HAL.since[obj] or tick()
            if tick() - HAL.since[obj] > 10 then -- not breaking: probably decoration
                HAL.skip[obj] = tick() + 180
                HAL.since[obj] = nil
                return dist
            end
            equipMelee()
            local part = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
            if part and RegisterAttack and RegisterHit then
                pcall(function() RegisterAttack:FireServer(0) end)
                local thread, send = combatThread(), getSend()
                if thread and send then
                    pcall(send, part, {{obj, part}})
                elseif not thread then
                    pcall(function() RegisterHit:FireServer(part, {{obj, part}}) end)
                end
            end
            local cam = workspace.CurrentCamera
            local mid = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(mid, cam.CFrame)
            task.wait(0.03)
            VirtualUser:Button1Up(mid, cam.CFrame)
        else
            HAL.since[obj] = nil
        end
        return dist
    end

    -----------------------------------------------------------------
    -- Gacha (Zioles): same remote as Roll Fruit. The box name of the
    -- Halloween gacha is guessed; if all guesses fail it is learned from
    -- one roll made by hand.
    -----------------------------------------------------------------
    local function saveRecipe()
        pcall(function() writefile(HAL.FILE, Hop.Http:JSONEncode({recipe = HAL.recipe})) end)
        Fluent:Notify({Title = "Dark Hub", Content = "Learned the Halloween gacha (" .. tostring(HAL.recipe and HAL.recipe.BoxName) .. "). It will be used by itself.", Duration = 8})
    end

    local function hook()
        if HAL.hooked or not (hookmetamethod and getnamecallmethod) then return end
        local rf = Net and Net:FindFirstChild("RF/GachaNetworkRF")
        if not rf then return end
        local old
        HAL.hooked = pcall(function()
            old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
                if self == rf and not HAL.rolling and getnamecallmethod() == "InvokeServer" then
                    local a = ...
                    if type(a) == "table" and a.Context == "Purchase" and a.BoxName and a.BoxName ~= "ZiolesGacha" and not HAL.recipe then
                        local copy = {}
                        for k, v in pairs(a) do copy[k] = v end
                        HAL.recipe, HAL.failed = copy, false
                        task.defer(saveRecipe)
                    end
                end
                return old(self, ...)
            end))
        end)
    end

    local function tokens()
        inventoryCount("")
        local total, name = 0, nil
        for n, c in pairs(invCache) do
            local l = n:lower()
            if l:find("candy corn", 1, true) or (l:find("spooky", 1, true) and l:find("token", 1, true)) then
                total += c
                name = n
            end
        end
        HAL.tokenName = name
        return total
    end

    local function rollOnce()
        local rf = Net and Net:FindFirstChild("RF/GachaNetworkRF")
        if not rf then return false end
        local args = HAL.recipe or {Context = "Purchase", BoxName = HAL.GUESS[HAL.guess]}
        local before = tokens()
        HAL.rolling = true
        local ok = pcall(function() return rf:InvokeServer(args) end)
        HAL.rolling = false
        task.wait(1.5)
        invAt = 0
        local after = tokens()
        if ok and after < before then
            HAL.rolls += 1
            if not HAL.recipe then
                HAL.recipe = args
                saveRecipe()
            end
            return true
        end
        if not HAL.recipe then
            HAL.guess += 1
            if HAL.guess > #HAL.GUESS then HAL.failed = true end
        end
        return false
    end

    task.spawn(function()
        while true do
            task.wait(5)
            if HAL.on and not HAL.failed then
                pcall(function()
                    local t = tokens()
                    HAL.lastTokens = t
                    if t >= HAL.minTokens then rollOnce() end
                end)
            end
        end
    end)

    -- Writes what the script found to DarkHub_halloween_scan.txt (names of doors,
    -- pumpkins, enemies and prompts near you) so the keywords can be corrected.
    local function dump()
        if not (writefile and HAL.on) then return end
        pcall(function()
            local lines = {"UTC " .. os.date("!%H:%M:%S") .. " | sea " .. tostring(CURRENT_SEA) .. " | tokens " .. HAL.lastTokens}
            for pr in pairs(HAL.prompts) do
                if pr.Parent and #lines < 120 then
                    lines[#lines + 1] = "DOOR | " .. pr:GetFullName() .. (pr:IsA("ProximityPrompt") and (" | " .. pr.ActionText .. " | " .. pr.ObjectText) or "")
                end
            end
            local n = 0
            for obj in pairs(HAL.things) do
                if obj.Parent and n < 80 then
                    n += 1
                    lines[#lines + 1] = "PUMPKIN | " .. obj.ClassName .. " | " .. obj:GetFullName()
                end
            end
            local seen = {}
            for _, mob in ipairs(workspace.Enemies:GetChildren()) do
                if not seen[mob.Name] and #lines < 260 then
                    seen[mob.Name] = true
                    lines[#lines + 1] = "ENEMY | " .. mob.Name .. " | tier " .. tostring(enemyTier(mob.Name))
                end
            end
            local root, near, k = getRoot(), 0, 0
            if root then
                for _, o in ipairs(workspace:GetDescendants()) do
                    k += 1
                    if k % 500 == 0 then task.wait() end
                    if near >= 80 then break end
                    if o:IsA("ProximityPrompt") then
                        local pos = posOf(o)
                        if pos and (pos - root.Position).Magnitude < 400 then
                            near += 1
                            lines[#lines + 1] = "NEAR PROMPT | " .. o:GetFullName() .. " | " .. o.ActionText .. " | " .. o.ObjectText
                        end
                    end
                end
            end
            writefile("DarkHub_halloween_scan.txt", table.concat(lines, "\n"))
        end)
    end

    -----------------------------------------------------------------
    -- Step of the farm loop: the biggest thing that exists wins
    -----------------------------------------------------------------
    halloween = function()
        if not HAL.on then return false end
        if workspace:GetServerTimeNow() >= HAL.END_TIME then
            HAL.on, State.Halloween = false, false
            refreshFarming()
            halStatus("Event ended")
            Fluent:Notify({Title = "Dark Hub", Content = "The Halloween event is over. Auto Event turned off.", Duration = 8})
            pcall(function() Fluent.Options.HalloweenAuto:SetValue(false) end)

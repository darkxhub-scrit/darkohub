    {id = "legendarysword", label = "Legendary Sword"},
    {id = "fruit", label = "Fruit Spawned"},
    {id = "fourhours", label = "4 Hours Uptime"},
    {id = "cakeprince", label = "Cake Prince", names = {"Cake Prince"}, localOnly = true},
}
Hop.cache, Hop.fetching = {}, {}

-- Reads the API list of one event in the background (refreshed every 20 s)
function Hop.refreshEvent(key)
    if Hop.fetching[key] then return end
    local c = Hop.cache[key]
    if c and tick() - c.t < 20 then return end
    Hop.fetching[key] = true
    task.spawn(function()
        local ok = pcall(function()
            if not Hop.request then error("your executor has no HTTP request function") end
            local res = Hop.request({
                Url = Hop.API .. "/api/logs/" .. key,
                Method = "GET",
                Headers = {["Content-Type"] = "application/json"},
            })
            if not res or not (res.StatusCode == 200 or res.Success == true) then
                error("the API did not answer (" .. tostring(res and res.StatusCode) .. ")")
            end
            local decoded = Hop.Http:JSONDecode(res.Body)
            local jobs = {}
            for _, e in ipairs(decoded[key] or {}) do
                if e.jobId and e.jobId ~= "" then
                    local good, job = pcall(Hop.decode, e.jobId)
                    if good and job and job ~= "" then jobs[job] = true end
                end
            end
            Hop.cache[key] = {t = tick(), jobs = jobs}
        end)
        if not ok then Hop.cache[key] = {t = tick(), jobs = {}} end
        Hop.fetching[key] = false
    end)
end

-- true: this server is in the API list of the event; false: it is not; nil: not read yet
function Hop.here(key)
    Hop.refreshEvent(key)
    local c = Hop.cache[key]
    if not c then return nil end
    return c.jobs[game.JobId] == true
end

-- Runs the Sea Events options that are on. Returns true while busy.
function Hop.eventStep()
    for _, ev in ipairs(Hop.EVENTS) do
        if State.HopOn[ev.id] then
            if ev.names and farmMobs({Mobs = ev.names}) then
                setStatus(ev.label .. " | fighting")
                return true
            end
            if ev.localOnly then
                setStatus(ev.label .. " | waiting for it to spawn on this server")
                return false
            end
            local here = Hop.here(ev.id)
            if here == nil then
                setStatus(ev.label .. " | checking the API")
            elseif here then
                setStatus(ev.label .. " | this server has it (staying here)")
            else
                setStatus(ev.label .. " | searching a server with it")
                Hop.join(ev.id, 8)
            end
            return true
        end
    end
    return false
end


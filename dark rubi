-- Settings tab: Remove Fog (fog, haze, smoke, clouds and glare/light effects)
local Lighting = game:GetService("Lighting")
local fogOn = false
local fogSaved = setmetatable({}, {__mode = "k"})
local fogConn, fogAdded

local function fogSet(inst, prop, value)
    local saved = fogSaved[inst]
    if not saved then saved = {}; fogSaved[inst] = saved end
    if saved[prop] == nil then saved[prop] = inst[prop] end
    inst[prop] = value
end

local function skipFog(o)
    return o:IsDescendantOf(Players) or (workspace:FindFirstChild("Characters") and o:IsDescendantOf(workspace.Characters))
        or (workspace:FindFirstChild("Enemies") and o:IsDescendantOf(workspace.Enemies))
        or (Player.Character and o:IsDescendantOf(Player.Character))
end

local function cleanFog(o)
    pcall(function()
        if o:IsA("Atmosphere") then
            fogSet(o, "Density", 0); fogSet(o, "Haze", 0); fogSet(o, "Glare", 0)
        elseif o:IsA("Clouds") then
            fogSet(o, "Enabled", false)
        elseif o:IsA("BloomEffect") or o:IsA("SunRaysEffect") or o:IsA("BlurEffect") or o:IsA("DepthOfFieldEffect") then
            fogSet(o, "Enabled", false)
        elseif o:IsA("Smoke") then
            if not skipFog(o) then fogSet(o, "Enabled", false) end
        elseif o:IsA("ParticleEmitter") then
            local n = o.Name:lower()
            if (n:find("smoke") or n:find("fog") or n:find("mist") or n:find("steam")) and not skipFog(o) then
                fogSet(o, "Enabled", false)
            end
        end
    end)
end

local function setFog(on)
    fogOn = on
    if fogConn then fogConn:Disconnect() fogConn = nil end
    if fogAdded then fogAdded:Disconnect() fogAdded = nil end
    if on then
        for _, o in ipairs(Lighting:GetDescendants()) do cleanFog(o) end
        for _, o in ipairs(workspace:GetDescendants()) do cleanFog(o) end
        -- the game changes the fog by itself (sea events, areas): keep it removed
        fogConn = RunService.Heartbeat:Connect(function()
            if Lighting.FogEnd < 9e8 then fogSet(Lighting, "FogEnd", 9e9) end
            if Lighting.FogStart < 9e8 then fogSet(Lighting, "FogStart", 9e9) end
        end)
        fogSet(Lighting, "FogEnd", 9e9)
        fogSet(Lighting, "FogStart", 9e9)
        fogAdded = workspace.DescendantAdded:Connect(cleanFog)
    else
        -- turned off: put everything back the way it was
        for inst, props in pairs(fogSaved) do
            for prop, value in pairs(props) do
                pcall(function() inst[prop] = value end)
            end
        end
        fogSaved = setmetatable({}, {__mode = "k"})
    end
end


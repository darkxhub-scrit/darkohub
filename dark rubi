end)

local function farmMobs(data, area)
    local target
    if data.Extra then target = findEnemy(data.Extra) end
    if not target and data.Boss then target = findEnemy({data.Boss}) end
    if not target and data.QuestMob and State.GetQuest and not data.KillAll then target = findEnemy({data.QuestMob}, area) end
    if not target and data.Mobs then target = findEnemy(data.Mobs, area) end

    if target then
        setHover(true)
        local hrp = target.HumanoidRootPart
        State.FightPos, State.FightAt = hrp.Position, tick()
        State.FightKey = data.Mobs and table.concat(data.Mobs, "|") or nil
        hrp.Size = Vector3.new(60, 60, 60)
        hrp.CanCollide = false
        bringMobs(target, data.Mobs)
        flyTo(hrp.CFrame * CFrame.new(0, hoverHeight(), 0))
        State.CombatUntil = tick() + 0.5
        return true
    end
    return false
end

-- No mob alive: stay where we were fighting and wait for the respawn
-- (mobs come back in a few seconds). Only after a long time without any
-- mob do we go looking at the spawn points of the farm area.
-- Returns "wait" | "hunt", spawn, distance | "none"
local function idleOrHunt(names, area)
    local key = table.concat(names, "|")
    if State.FightPos and State.FightKey == key and tick() - State.FightAt < 60 then
        setHover(true)
        flyTo(CFrame.new(State.FightPos + Vector3.new(0, ATTACK_HEIGHT, 0)))
        return "wait"
    end
    local sp = findHuntSpawn(names, area)
    if sp then
        local root = getRoot()
        local dist = root and (sp.Position - root.Position).Magnitude or 0
        setHover(true)
        flyTo(sp.CFrame * CFrame.new(0, HOVER_HEIGHT + 8, 0))
        return "hunt", sp, dist
    end
    setHover(false)
    return "none"
end


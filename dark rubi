local levelCache = {lk = nil, data = nil, t = 0, key = nil}

local mobSet
local function getMobSet()
    if mobSet then return mobSet end
    mobSet = {}
    local ok, quests = pcall(function() return require(RS:WaitForChild("Quests", 5)) end)
    if ok and type(quests) == "table" then
        for _, levels in pairs(quests) do
            if type(levels) == "table" then
                for _, q in pairs(levels) do
                    if type(q) == "table" and type(q.Task) == "table" then
                        for n in pairs(q.Task) do mobSet[n] = true end
                    end
                end
            end
        end
    end
    return mobSet
end

local function activeQuestMob()
    local gui = Player.PlayerGui:FindFirstChild("Main")
    local q = gui and gui:FindFirstChild("Quest")
    if not q or not q.Visible then return end
    local ok, text = pcall(function() return q.Container.QuestTitle.Title.Text end)
    if not ok or type(text) ~= "string" then return end
    local cur, max = text:match("(%d+)%s*/%s*(%d+)")
    if cur and max and tonumber(cur) >= tonumber(max) then return end
    local best
    for name in pairs(getMobSet()) do
        if text:find(name, 1, true) and (not best or #name > #best) then best = name end
    end
    return best
end

local SEA_TRAVEL = {"TravelMain", "TravelDressrosa", "TravelZou"}
local lastSeaTravel, seaTravelTries = 0, 0

local function getLevelQuest()
    local lvl = getLevel()
    -- the sea we are in decides which quests exist (the level alone is not enough)
    local seaNow = (CURRENT_SEA and SEA_RANGE[CURRENT_SEA]) and CURRENT_SEA or (lvl >= 1500 and 3 or (lvl >= 700 and 2 or 1))
    local lk = lvl .. ":" .. seaNow
    local age = tick() - levelCache.t
    if levelCache.lk == lk and (levelCache.data and age < 60 or age < 5) then
        return levelCache.data
    end
    levelCache.lk, levelCache.t = lk, tick()

    local ok, quests = pcall(function() return require(RS:WaitForChild("Quests", 5)) end)
    if not ok or type(quests) ~= "table" then
        levelCache.data = nil
        warn("[Dark Hub] could not read the game's quest list")
        return
    end

    -- Only the level and the sea decide the quest (the same rule as the game's own
    -- quest list). Spawns are NOT checked here: they only exist around the player
    -- (they stream in), so checking them kept the quest of the island we had just
    -- left. Ties in LevelReq are broken by name, so a level always gives the same quest.
    local range = SEA_RANGE[seaNow]
    local best, bestReq = nil, -1
    for questName, levels in pairs(quests) do
        if type(levels) == "table" and not SKIP_GROUPS[questName] then
            for idx, q in pairs(levels) do
                if type(q) == "table" and q.LevelReq and q.Task and q.LevelReq <= lvl
                    and q.LevelReq >= range[1] and q.LevelReq < range[2]
                    and (q.LevelReq > bestReq or (q.LevelReq == bestReq and best and questName < best.Name)) then
                    local mobName, count
                    for n, c in pairs(q.Task) do mobName, count = n, c end
                    if mobName and count and count > 1 then
                        best, bestReq = {Name = questName, Level = idx, Mob = mobName}, q.LevelReq
                    end
                end
            end
        end
    end

    if not best then
        levelCache.data = nil
        if levelCache.warned ~= lvl then
            levelCache.warned = lvl
            Fluent:Notify({Title = "Dark Hub", Content = "Level " .. lvl .. ": no quest found in this sea. Travel to the right sea.", Duration = 8})
        end
        return
    end

    levelCache.data = {
        Mobs = {best.Mob},
        QuestMob = best.Mob,
        Label = best.Name .. " #" .. best.Level,
        Quest = {Name = best.Name, Level = best.Level, NPC = QUEST_CF[best.Name], NPCName = QUEST_NPC[best.Name] or MOB_NPC[best.Mob]},
        Submerged = tostring(best.Name):find("Submerged") ~= nil or SUBMERGED_MOBS[best.Mob] == true,
    }
    local key = best.Name .. best.Level
    if levelCache.key ~= key then
        levelCache.key = key
        Fluent:Notify({Title = "Dark Hub", Content = "Level " .. lvl .. " -> farming " .. best.Mob .. " (" .. best.Name .. " #" .. best.Level .. ")", Duration = 6})
    end
    return levelCache.data
end


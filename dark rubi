        local t0 = tick()
        while tw.PlaybackState == Enum.PlaybackState.Playing and tick() - t0 < dur + 2 do
            if stop and stop() then tw:Cancel() return false end
            task.wait(0.1)
        end
        return tw.PlaybackState == Enum.PlaybackState.Completed
    end


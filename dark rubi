-- decodes the job id given by the API
function Hop.decode(arg)
    local str3 = arg:gsub("^%.", ""):gsub("%.$", "")
    local kept, n = {}, 0
    for i = 1, #str3 do
        n += 1
        if n % 5 ~= 0 then table.insert(kept, str3:sub(i, i)) end
    end
    local str4 = table.concat(kept)
    local out, pos, idx = {}, 1, 1
    local function fn3(a, b)
        return (a - Hop.SECRET:byte((b - 1) % #Hop.SECRET + 1) - b) % 32
    end
    while pos <= #str4 do
        local n4 = Hop.ALPHABET:find(str4:sub(pos, pos), 1, true) - 1
        local n5 = Hop.ALPHABET:find(str4:sub(pos + 1, pos + 1), 1, true) - 1
        table.insert(out, string.char(fn3(n4, idx) + fn3(n5, idx + 100) * 32))
        pos += 2
        idx += 1
    end
    return table.concat(out)
end

-- keeps the options switched on while we change server (restored on the next server)
function Hop.save(hopping)
    pcall(function()
        local hopSet = {}
        for id in pairs(State.HopOn) do hopSet[id] = true end
        writefile(Hop.STATE_FILE, Hop.Http:JSONEncode({hopping = hopping == true, ghoul = State.Ghoul, cyborg = State.Cyborg, hop = hopSet}))
    end)
end

-- Read right now (before the UI exists: building the UI saves the file again)
Hop.pending = nil
pcall(function()
    if isfile and isfile(Hop.STATE_FILE) then
        local data = Hop.Http:JSONDecode(readfile(Hop.STATE_FILE))
        if data.hopping then Hop.pending = data end
    end
end)

-- After a hop: switches the options that were on back on
function Hop.restore()
    local data = Hop.pending
    Hop.pending = nil
    if not data then return end
    pcall(function()
        if data.ghoul and Fluent.Options.AutoGhoul then Fluent.Options.AutoGhoul:SetValue(true) end
        if data.cyborg and Fluent.Options.AutoCyborg then Fluent.Options.AutoCyborg:SetValue(true) end
        for id in pairs(data.hop or {}) do
            local opt = Fluent.Options["Hop_" .. id] or Fluent.Options["Sea_" .. id]
            if opt then opt:SetValue(true) end
        end
    end)
end


-- Buys the Order raid Microchip from Arlthmetic (1000 Fragments)
function Cyb.buyChip()
    local npc = labNPC()
    local ok, p = false, nil
    if npc then ok, p = pcall(function() return npc:GetPivot().Position end) end
    if not ok then p = (Cyb.center()) end
    if not Cyb.goTo(p + Vector3.new(0, 4, 0), 15) or not npc then return end
    if tick() - (Cyb.last.buy or 0) < 4 then return end
    Cyb.last.buy = tick()
    local calls = Cyb.recipe and {Cyb.recipe} or Cyb.BUY_TRIES
    if not Cyb.recipe then Cyb.hook() end
    if not Cyb.recipe and Cyb.buyTry >= #calls * 2 then
        hopNote("Buy the Microchip from Arlthmetic by hand once (" .. Cyb.CHIP_COST .. " Fragments): the script learns the purchase and repeats it by itself.")
        return
    end
    Cyb.buyTry += 1
    local args = calls[(Cyb.buyTry - 1) % #calls + 1]
    pcall(function() RS.Remotes.CommF_:InvokeServer(table.unpack(args)) end)
end

-- Makes sure we are at the lab; returns its center, or nil while flying there
local function labReady(tag, step)
    local center, exact = Cyb.center()
    if exact then return center end
    setStatus(tag .. step .. " flying to the lab of Hot and Cold")
    if Cyb.goTo(center, 80) then
        Cyb.noNpcAt = Cyb.noNpcAt or tick()
        if tick() - Cyb.noNpcAt > 10 then
            hopNote("Arlthmetic not found. Stand inside the dark blue chamber of the Secret Laboratory and press Save Raid Spot (Stack Farm).")
        end
    end
end

local function startRaid(tag)
    local center = labReady(tag, "3/4")
    if not center then return end
    setStatus(tag .. "3/4 starting the Order (Law) raid")
    if tick() < Cyb.wait then return end
    if Cyb.press(center) == "fired" then
        Cyb.pressAt = tick()
        Cyb.wait = tick() + 8
    end
end

local function insertFist(tag)
    local center = labReady(tag, "2/4")
    if not center then return end
    setStatus(tag .. "2/4 inserting the Fist of Darkness in the Secret Laboratory")
    if tick() < Cyb.wait then return end
    if Cyb.insertTry > 0 and not hasItem(Cyb.FIST) then -- it was taken by the machine
        Cyb.fist = true
        Cyb.save()
        pcall(function() Fluent.Options.CyborgFist:SetValue(true) end)
        Fluent:Notify({Title = "Dark Hub", Content = "Fist of Darkness inserted. Now the Order raids run until the Core Brain drops.", Duration = 8})
        return
    end
    if Cyb.press(center) == "fired" then
        Cyb.insertTry += 1
        Cyb.wait = tick() + 6
        if Cyb.insertTry == 8 then
            hopNote("The Fist is not being accepted. Stand inside the dark blue chamber and press Save Raid Spot (Stack Farm).")
        end
    end
end

local function raidLoop(tag)
    if hasChip() then
        startRaid(tag)
        return
    end
    local f = fragments()
    if f and f < Cyb.CHIP_COST then
        setStatus(tag .. "3/4 need " .. Cyb.CHIP_COST .. " Fragments for the next Microchip (you have " .. f .. ")")
        return
    end
    setStatus(tag .. "3/4 buying the Microchip from Arlthmetic")
    Cyb.buyChip()
end

local function useBrain(tag)
    local center = labReady(tag, "4/4")
    if not center then return end
    setStatus(tag .. "4/4 using the Core Brain on the lab button (opens the secret door)")
    if tick() < Cyb.wait then return end
    if Cyb.brainTry >= 1 and (not hasItem(Cyb.BRAIN) or Cyb.brainTry >= 3) then
        Cyb.door = true
        Cyb.save()
        return
    end
    if Cyb.press(center) == "fired" then
        Cyb.brainTry += 1
        Cyb.wait = tick() + 6
    end
end

local function buyRace(tag)
    local f = fragments()
    if f and f < Cyb.RACE_COST then
        setStatus(tag .. "4/4 need " .. Cyb.RACE_COST .. " Fragments to buy Cyborg (you have " .. f .. ")")
        return
    end
    setStatus(tag .. "4/4 buying the Cyborg race (" .. Cyb.RACE_COST .. " Fragments)")
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        for _, n in ipairs(npcs:GetChildren()) do
            if n.Name:lower():find("cyborg", 1, true) then
                local ok, p = pcall(function() return n:GetPivot().Position end)
                if ok and not Cyb.goTo(p + Vector3.new(0, 4, 0), 20) then return end
                break
            end
        end
    end
    if tick() - (Cyb.last.race or 0) < 4 then return end
    Cyb.last.race = tick()
    Cyb.raceTry += 1
    local ok, res = pcall(function() return RS.Remotes.CommF_:InvokeServer("CyborgTrainer", "Buy") end)
    if ok and type(res) == "string" then hopNote("Cyborg: " .. res) end
    if Cyb.raceTry >= 6 and hasItem(Cyb.BRAIN) then -- the door did not open: use the Core Brain again
        Cyb.door, Cyb.brainTry, Cyb.raceTry = false, 0, 0
        Cyb.save()
    end
end

local function huntFist(tag)
    if collectChests() then
        Cyb.noChestAt = nil
        setStatus(tag .. "1/4 collecting chests (looking for the Fist of Darkness)")
        return
    end
    Cyb.noChestAt = Cyb.noChestAt or tick()
    if tick() - Cyb.noChestAt < 6 or tick() - Hop.startAt < 12 then
        setStatus(tag .. "1/4 no chests here, checking again")
        return
    end
    setStatus(tag .. "1/4 no more chests in this server, joining another one")
    if tick() - (Cyb.last.hop or 0) > 20 then
        Cyb.last.hop = tick()
        task.spawn(function()
            if not Hop.anyServer() then hopNote("No other server found.") end
        end)
    end
end

local function raidTimerOn()
    local main = Player.PlayerGui:FindFirstChild("Main")
    local t = main and main:FindFirstChild("Timer")
    return t ~= nil and t.Visible and tick() - Cyb.pressAt < 480
end

local function cyborgRace()
    local tag = "Auto Cyborg | "
    if CURRENT_SEA and CURRENT_SEA ~= 2 then
        setStatus(tag .. "only works in Sea 2 (detected: Sea " .. tostring(CURRENT_SEA) .. ")")
        return true
    end
    local data = Player:FindFirstChild("Data")
    local race = data and data:FindFirstChild("Race") and data.Race.Value
    if race == "Cyborg" then
        Fluent:Notify({Title = "Dark Hub", Content = "You are Cyborg now!", Duration = 8})
        pcall(function() Fluent.Options.AutoCyborg:SetValue(false) end)
        return false
    end

    local brain = hasItem(Cyb.BRAIN)
    if not invReady then
        setStatus(tag .. "reading your inventory...")
        invAt = 0
        return true
    end

    -- an Order raid is running: fight Order
    if findEnemy(Cyb.ORDER) then
        setStatus(tag .. "3/4 fighting Order (Law raid)")
        farmMobs({Mobs = Cyb.ORDER})
        return true
    end
    if raidTimerOn() then
        setStatus(tag .. "3/4 raid running, waiting for Order")
        return true
    end

    if Cyb.door then
        buyRace(tag)
    elseif brain then
        useBrain(tag)
    elseif hasChip() and not Cyb.fist then
        startRaid(tag) -- a Microchip in the backpack blocks the Fist: use it first
    elseif Cyb.fist then
        raidLoop(tag)
    elseif hasItem(Cyb.FIST) then
        insertFist(tag)
    else
        huntFist(tag)
    end
    return true
end


local function tradeChalice()
    local npc = findChaliceNPC()
    local root = getRoot()
    if npc and root then
        local okp, p = pcall(function() return npc:GetPivot().Position end)
        if okp and (root.Position - p).Magnitude > 20 then
            setHover(true)
            flyTo(CFrame.new(p + Vector3.new(0, 4, 0)))
            return
        end
    end
    if tick() - lastTrade > 6 then
        lastTrade = tick()
        pcall(function() RS.Remotes.CommF_:InvokeServer("SweetChaliceNpc") end)
        invAt = 0 -- re-read the inventory right away
    end
end

local lastSpawner = 0
local function fullyDK()
    local tag = "Fully Dough King | "
    if CURRENT_SEA ~= 3 then
        setStatus(tag .. "only works in Sea 3 (detected: Sea " .. tostring(CURRENT_SEA) .. ")")
        return true
    end

    -- 1) an Elite Hunter is spawned: defeat it first
    if findEnemy(ELITE_NAMES) then
        setStatus(tag .. "1/4 killing the Elite Hunter")
        farmMobs({Mobs = ELITE_NAMES})
        return true
    end

    local sweet = inventoryCount(ITEM_SWEET)
    local chalice = inventoryCount(ITEM_CHALICE)

    -- 2) collect chests until the Chalice shows up
    if sweet == 0 and chalice == 0 then
        setStatus(tag .. "2/4 collecting chests (looking for the Chalice)")
        if not collectChests() then
            setStatus(tag .. "2/4 no chests found, waiting for them to spawn")
        end
        return true
    end

    -- 3) Cocoa -> Sweet Chalice
    if sweet == 0 then
        local cocoa = inventoryCount(ITEM_COCOA)
        if cocoa < COCOA_NEEDED then
            setStatus(tag .. "3/4 farming Cocoa (" .. cocoa .. "/" .. COCOA_NEEDED .. ")")
            return huntMobs(COCOA_MOBS)
        end
        setStatus(tag .. "3/4 trading Cocoa for the Sweet Chalice")
        tradeChalice()
        return true
    end

    -- 4) kill Cake Land mobs until the boss spawns
    local boss = findEnemy(DK_BOSSES)
    if boss then
        Fluent:Notify({Title = "Dark Hub", Content = boss.Name .. " spawned!", Duration = 8})
        pcall(function() Fluent.Options.FullyDK:SetValue(false) end)
        return false
    end
    setStatus(tag .. "4/4 killing Cake Land mobs (500 needed)")
    if tick() - lastSpawner > 10 then
        lastSpawner = tick()
        pcall(function() RS.Remotes.CommF_:InvokeServer("CakePrinceSpawner") end)
    end
    return huntMobs(Methods["Katakuri"].Mobs)
end

local function ripIndra()

-- Inventory (refreshed every few seconds)
local invCache, invAt, invReady = {}, 0, false
local function inventoryCount(name)
    if tick() - invAt > 4 then
        invAt = tick()
        local ok, inv = pcall(function() return RS.Remotes.CommF_:InvokeServer("getInventory") end)
        if ok and type(inv) == "table" then
            invCache = {}
            invReady = true
            for _, it in pairs(inv) do
                if type(it) == "table" and it.Name then invCache[it.Name] = it.Count or 1 end
            end
        end
    end
    return invCache[name] or 0
end

-- Kills the mobs, or flies from spawn to spawn looking for them
local function huntMobs(names)
    local area = getFarmArea(names)
    if farmMobs({Mobs = names}, area) then return true end
    idleOrHunt(names, area)
    return true
end

-- Chests of the server (the Chalice comes from them)
local chestSkip = setmetatable({}, {__mode = "k"})
local chestCur, chestSince = nil, 0

local function chestPart(o)
    return o:IsA("BasePart") and o or o:FindFirstChildWhichIsA("BasePart", true)
end

local function nextChest()
    local root = getRoot()
    if not root then return end
    local best, bd = nil, math.huge
    local function consider(o)
        if chestSkip[o] and tick() - chestSkip[o] < 60 then return end
        local p = chestPart(o)
        if p then
            local d = (p.Position - root.Position).Magnitude
            if d < bd then best, bd = o, d end
        end
    end
    for _, o in ipairs(CollectionService:GetTagged("_ChestTagged")) do consider(o) end
    if not best then
        local folder = workspace:FindFirstChild("ChestModels")
        if folder then
            for _, o in ipairs(folder:GetChildren()) do consider(o) end
        end
    end
    return best
end

local function collectChests()
    local chest = nextChest()
    if not chest then return false end
    if chest ~= chestCur then chestCur, chestSince = chest, tick() end
    if tick() - chestSince > 8 then -- stuck on this one: skip it for a while
        chestSkip[chest] = tick()
        chestCur = nil
        return true
    end
    local part = chestPart(chest)
    local root = getRoot()
    if not part or not root then return true end
    setHover(true)
    flyTo(part.CFrame)
    pcall(function()
        firetouchinterest(root, part, 0)
        firetouchinterest(root, part, 1)
    end)
    return true
end


    -- scripts of the character that hold the cooldown values (found once per character)
    local function scriptTables(name, test)
        local char = Player.Character
        local scr = char and char:FindFirstChild(name)
        local found = {}
        if not scr or not getgc then return found end
        for _, f in ipairs(getgc()) do
            if typeof(f) == "function" then
                local okEnv, env = pcall(getfenv, f)
                if okEnv and type(env) == "table" and env.script == scr then
                    pcall(function()
                        for k, up in pairs(getupvalues(f)) do test(f, k, up, found) end
                    end)
                end
            end
        end
        return found
    end


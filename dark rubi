        end
        local obj = nearestThing()
        if obj then
            local d = smash(obj)
            halStatus("pumpkin: " .. obj.Name .. " (" .. math.floor(d or 0) .. " studs)" .. tail)
            return true
        end

        local active, mins = harvestInfo()
        halStatus((active and ("Harvest Moon is on (" .. mins .. " min left) | looking for doors") or ("waiting for the next Harvest Moon (" .. mins .. " min)")) .. tail)

-- Haunted Ship (Sea 2): Cursed Captain + Ghoul race
-- NOTE: the door coordinates, item names and the Ghoul trade NPC/remote are
-- best guesses and can change with game updates (see the constants).
---------------------------------------------------------------------
State.Captain = false
State.Ghoul = false

local SHIP_DOOR = Vector3.new(923.21, 126.98, 32852.83) -- Haunted Ship door
local CAPTAIN_NAMES = {"Cursed Captain"}
local SHIP_MOBS = {"Ship Deckhand", "Ship Engineer", "Ship Steward", "Ship Officer"}
local ITEM_ECTO, ITEM_TORCH = "Ectoplasm", "Hellfire Torch"
local ECTO_NEEDED = 100
local GHOUL_NPC = "Wenlocktoad" -- NPC that trades the torch for the Ghoul race

local lastEnter, doorTries = 0, 0
-- Goes through the ship door: the game teleports you straight inside
local function enterShip()
    if tick() - lastEnter < 8 then return end
    lastEnter = tick()
    doorTries += 1
    pcall(function() RS.Remotes.CommF_:InvokeServer("requestEntrance", SHIP_DOOR) end)
end

-- Fights the Cursed Captain if he is spawned. Returns true while busy.
local function killCaptain()
    local boss = findEnemy(CAPTAIN_NAMES)
    if not boss then
        doorTries = 0
        return false
    end
    local root = getRoot()
    local hrp = boss:FindFirstChild("HumanoidRootPart")
    -- not near the ship yet: use the door (if it does not help after 2 tries, fly)
    if root and hrp and (root.Position - hrp.Position).Magnitude > 1500 and doorTries < 2 then
        enterShip()
        return true
    end
    return farmMobs({Mobs = CAPTAIN_NAMES})
end

-- Ship mobs (they drop Ectoplasm). Goes through the door first if far away.
local function farmShipMobs()
    local area = getFarmArea(SHIP_MOBS)
    local root = getRoot()
    if area and root and (root.Position - area.center).Magnitude > 1500 and doorTries < 3 then
        enterShip()
        return true
    end
    return huntMobs(SHIP_MOBS)
end

local lastGhoulTry, ghoulFails = 0, 0
local function tradeTorch()
    local npcs = workspace:FindFirstChild("NPCs")
    local npc = npcs and npcs:FindFirstChild(GHOUL_NPC)
    local root = getRoot()
    if npc and root then
        local okp, p = pcall(function() return npc:GetPivot().Position end)
        if okp and (root.Position - p).Magnitude > 20 then
            setHover(true)
            flyTo(CFrame.new(p + Vector3.new(0, 4, 0)))
            return
        end
    end
    if tick() - lastGhoulTry > 6 then
        lastGhoulTry = tick()
        ghoulFails += 1
        pcall(function() RS.Remotes.CommF_:InvokeServer(GHOUL_NPC, "1") end)
        if ghoulFails == 4 then
            Fluent:Notify({Title = "Dark Hub", Content = "Could not trade the Hellfire Torch automatically. Talk to the NPC by hand to become Ghoul.", Duration = 10})
        end
    end
end

local function cursedCaptain()
    if CURRENT_SEA ~= 2 then
        setStatus("Cursed Captain | only works in Sea 2 (detected: Sea " .. tostring(CURRENT_SEA) .. ")")
        return false
    end
    if killCaptain() then
        setStatus("Cursed Captain | fighting")
        return true
    end
    setStatus("Cursed Captain | waiting for him to spawn")
    return false
end

local function ghoulRace()
    local tag = "Fully Ghoul | "
    -- only block when the sea is KNOWN and is not Sea 2 (an undetected sea must not freeze the hop)
    if CURRENT_SEA and CURRENT_SEA ~= 2 then
        setStatus(tag .. "only works in Sea 2 (detected: Sea " .. tostring(CURRENT_SEA) .. ")")
        return true
    end
    local data = Player:FindFirstChild("Data")
    local race = data and data:FindFirstChild("Race") and data.Race.Value
    if race == "Ghoul" then
        Fluent:Notify({Title = "Dark Hub", Content = "You are Ghoul now!", Duration = 8})
        pcall(function() Fluent.Options.AutoGhoul:SetValue(false) end)
        return false
    end

    -- 3) torch in hand: trade it for the race
    if inventoryCount(ITEM_TORCH) > 0 then
        setStatus(tag .. "3/3 trading the Hellfire Torch for the Ghoul race")
        tradeTorch()
        return true
    end

    -- The Ectoplasm amount is read BEFORE deciding anything (farm or hop).
    -- Right after a hop the inventory is read again from scratch.
    local ecto = inventoryCount(ITEM_ECTO)
    if not invReady then
        setStatus(tag .. "reading your inventory (Ectoplasm)...")
        invAt = 0
        return true
    end

    -- 1) less than ECTO_NEEDED Ectoplasm: farm it on the ship (no hop yet)
    if ecto < ECTO_NEEDED then
        setStatus(tag .. "1/3 farming Ectoplasm (" .. ecto .. "/" .. ECTO_NEEDED .. ")")
        return farmShipMobs()
    end

    -- 2) ECTO_NEEDED+ Ectoplasm: only the Cursed Captain matters now
    if killCaptain() then
        setStatus(tag .. "2/3 killing the Cursed Captain (" .. ecto .. " Ectoplasm, waiting for the Hellfire Torch)")
        return true
    end
    -- not spawned in this server: hop right away (short wait so the server
    -- finishes loading and the boss, if any, shows up in the enemy list)
    if tick() - Hop.startAt > 5 then
        setStatus(tag .. "2/3 " .. ecto .. " Ectoplasm, Captain not spawned -> hopping to a server with him")
        Hop.join("CursedCaptain", 8)
    else
        setStatus(tag .. "2/3 " .. ecto .. " Ectoplasm, checking this server for the Captain")
    end
    return true
end


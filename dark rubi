local TIKI_POS = Vector3.new(-16269.7, 25.2, 1373.4) -- approximate; the real NPC is searched first
local lastSubTravel, subFails = 0, 0

local function findSubmarineNPC()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return end
    local direct = npcs:FindFirstChild("Submarine Worker")
    if direct then return direct end
    for _, n in ipairs(npcs:GetChildren()) do
        if n.Name:find("Submarine", 1, true) then return n end
    end
end

-- Flies to the Submarine Worker and talks to him ("Travel to Submerged Island").
-- Tries the new remote, the old remote and the NPC's interact prompt, and only
-- counts as success when the character really got teleported away.
local function goSubmerged()
    if tick() - lastSubTravel < 8 then return end
    lastSubTravel = tick()

    local npc = findSubmarineNPC()
    local okp, npcPos = false, nil
    if npc then okp, npcPos = pcall(function() return npc:GetPivot().Position end) end
    local pos = (okp and npcPos) or TIKI_POS

    flyAndWait(CFrame.new(pos + Vector3.new(0, 4, 0)))
    if not State.Farming then return end

    local root = getRoot()
    if not root then return end
    local before = root.Position
    local function moved()
        local r = getRoot()
        return r and (r.Position - before).Magnitude > 300
    end

    local attempts = {
        function() -- 1) current game version
            local rf = Net and Net:FindFirstChild("RF/SubmarineWorkerSpeak")
            if rf then rf:InvokeServer("TravelToSubmergedIsland") end
        end,
        function() -- 2) old version
            RS.Remotes.CommF_:InvokeServer("SubmarineWorkerSpeak", "TravelToSubmergedIsland")
        end,
        function() -- 3) press the "Interact" prompt of the NPC
            local prompt = npc and npc:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then fireproximityprompt(prompt) end
        end,
    }
    for _, try in ipairs(attempts) do
        pcall(try)
        for _ = 1, 8 do
            task.wait(0.5)
            if moved() then break end
        end
        if moved() then
            subFails = 0
            State.SubUntil = tick() + 40 -- we are on the Submerged Island now
            task.wait(2)
            return
        end
        if not State.Farming then return end
    end

    subFails += 1
    if subFails == 2 then
        Fluent:Notify({Title = "Dark Hub", Content = "Could not travel to the Submerged Island. Talk to the Submarine Worker once by hand (Travel to Submerged Island) and the farm continues from there.", Duration = 10})
    end
end

